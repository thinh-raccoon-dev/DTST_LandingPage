# Copy this file to `.env.local` and fill in the values.
#
# Public URL of the Beta registration API (HTTPS, accepts POST application/json).
# Leave empty until a real backend exists: the form will then validate input
# but will clearly tell the user that nothing was sent.
#
# NOTE: Every VITE_* variable is bundled into the public frontend code.
# Never put secret keys or private tokens here.
VITE_BETA_REGISTRATION_ENDPOINT=
